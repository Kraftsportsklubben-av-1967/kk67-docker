# Paths to the service source trees (relative to the repo root).
# kk67-frontend and kk67-backend-php are tracked as submodules. The Flask
# backend lives in a separate repository; clone it into webroot/kk67-backend
# if you want to enable the `dev` profile (kk67_be service).
BE_APP_PATH=./webroot/kk67-backend
BE_PHP_APP_PATH=./webroot/kk67-backend-php
FE_APP_PATH=./webroot/kk67-frontend

# Frontend host port and local-cors-proxy port.
# FE_PROXY_PORT must match VITE_PROXY_PORT in the frontend's .env.
FE_PORT=3000
FE_PROXY_PORT=2000

# PHP backend host port.
BE_PHP_PORT=4000

# Optional local FTPS credentials for the application repositories' uploaders.
# Select this file with their -EnvFilePath option; CI uses encrypted secrets.
# Keep .env private. Do not use VITE_ prefixes for these secrets.
FTP_USERNAME=''
FTP_PASSWORD=''
